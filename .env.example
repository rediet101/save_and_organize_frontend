# Copy to .env.local (git-ignored) to override for your machine. Vite does not read this file.

# Where the FastAPI backend runs. Used only by the dev server's /api proxy (/api/* -> BACKEND_URL/*).
# The backend serves /health and /extract at its root, so no /api suffix here.
# BACKEND_URL=http://localhost:8000
BACKEND_URL=https://save-and-organize.onrender.com

# Call the backend directly instead of through the /api proxy. Production builds get this
# from .env.production; the backend's CORS_ORIGINS must allow the site's origin.
# VITE_API_URL=https://save-and-organize.onrender.com
